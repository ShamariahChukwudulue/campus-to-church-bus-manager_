# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
# If MongoDB is running locally, use mongodb://127.0.0.1:27017/campus_church_bus
# If not detected, the system will automatically run with an embedded in-memory MongoDB instance for zero-friction testing.
MONGODB_URI=mongodb://127.0.0.1:27017/campus_church_bus

# JWT Configuration
JWT_SECRET=supersecret_campus_church_bus_jwt_key_2026_dev_only
JWT_EXPIRES_IN=7d

# Default Admin Seed Credentials
ADMIN_NAME=Campus Admin
ADMIN_EMAIL=admin@campusbus.edu
ADMIN_PASSWORD=AdminPass123!
